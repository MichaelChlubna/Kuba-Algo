# Copy to .env (never commit .env). All values are optional.

# HTTP Basic auth for the web app. Required as soon as the app is reachable from the internet.
FP_AUTH_USER=
FP_AUTH_PASSWORD=

# Where the web port is published: 127.0.0.1 = this machine only, 0.0.0.0 = all interfaces (server / VPS)
FP_BIND=127.0.0.1
FP_PUBLIC_PORT=8000

# Rolling data window (days ending yesterday) and the daily update time (UTC; Binance publishes ~07-09 UTC)
FP_RETENTION_DAYS=30
FP_UPDATE_AT=09:30

# Live data from the Binance WebSocket (public market stream, no API key). 0 = only the daily dumps.
FP_LIVE=1

# Data come from public Binance endpoints (data.binance.vision, fapi/fstream.binance.com): no API key is
# needed. If a key is ever needed, it belongs here (backend only), never into the frontend:
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
